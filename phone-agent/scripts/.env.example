# Phone Agent — конфигурация. Скопируй в .env и заполни.
# Телефония: v1 под Twilio. Для РФ — Voximplant, для УЗ — pbx.uz/SIP или Aisha AI.
# См. SKILL.md «Провайдеры по регионам» — смена провайдера = адаптация /voice и WS.

# --- Twilio (обязательно) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX        # номер, с которого агент звонит

# --- Публичный адрес сервера (обязательно, HTTPS!) ---
PUBLIC_BASE_URL=https://phone.example.com

# --- STT: Deepgram (обязательно, https://deepgram.com — есть $200 кредитов) ---
DEEPGRAM_API_KEY=

# --- LLM: OpenAI-совместимый (KiloCode по умолчанию) ---
LLM_API_KEY=                              # KILOCODE_API_KEY
LLM_CHAT_URL=https://api.kilo.ai/api/gateway/chat/completions
# Если Kilo отвечает 404 — попробуй https://api.kilo.ai/api/gateway/v1/chat/completions
LLM_MODEL=deepseek/deepseek-v4-flash:discounted

# --- TTS: elevenlabs | edge (edge бесплатно, но голос проще) ---
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Системный промпт по умолчанию (для входящих звонков) ---
SYSTEM_PROMPT=Ты — голосовой ассистент. Отвечай кратко и по делу. Разговаривай естественно.

# --- Куда писать транскрипты (по умолчанию ~/.hermes/phone_agent/logs) ---
# LOG_DIR=/root/.hermes/phone_agent/logs
