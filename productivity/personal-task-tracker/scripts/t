#!/usr/bin/env python3
"""CLI трекер задач и привычек (SQLite)."""
import sqlite3, sys, os, argparse, datetime, shutil
from pathlib import Path
from zoneinfo import ZoneInfo

DB = Path.home() / ".hermes" / "tasks" / "tasks.db"
DB.parent.mkdir(parents=True, exist_ok=True)
MSK = ZoneInfo("Europe/Moscow")

def get_db():
    conn = sqlite3.connect(str(DB))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    return conn

def init_db():
    conn = get_db()
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            priority TEXT DEFAULT 'M',
            category TEXT DEFAULT 'general',
            status TEXT DEFAULT 'pending',
            due_date TEXT,
            created_at TEXT DEFAULT (datetime('now','localtime')),
            done_at TEXT,
            carry_over INTEGER DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS habits (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            time TEXT,
            sort_order INTEGER DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS habit_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            habit_id INTEGER NOT NULL,
            date TEXT NOT NULL,
            done INTEGER DEFAULT 0,
            done_at TEXT,
            FOREIGN KEY (habit_id) REFERENCES habits(id)
        );
    """)
    conn.commit()
    conn.close()

def add_days_column():
    """Добавить колонку days в habits (если нет)."""
    conn = get_db()
    try:
        conn.execute("ALTER TABLE habits ADD COLUMN days TEXT DEFAULT '*'")
    except Exception:
        pass
    conn.commit()
    conn.close()

def today():
    return datetime.datetime.now(MSK).date().isoformat()

def tomorrow():
    return (datetime.date.today() + datetime.timedelta(days=1)).isoformat()

def tomorrow_msk():
    return (datetime.datetime.now(MSK).date() + datetime.timedelta(days=1)).isoformat()

def parse_date(s):
    """Парсит 'today', 'tomorrow', 'сегодня', 'завтра' в ISO-дату.
       Валидирует YYYY-MM-DD формат. Возвращает None при невалидной дате."""
    if not s:
        return None
    s = s.strip().lower()
    if s in ("today", "сегодня"):
        return today()
    if s in ("tomorrow", "завтра"):
        return tomorrow_msk()
    # проверить что это валидная YYYY-MM-DD дата
    try:
        datetime.datetime.strptime(s, "%Y-%m-%d")
        return s
    except ValueError:
        return None

# ─── Задачи ─────────────────────────────────

def cmd_add(args):
    conn = get_db()
    date = parse_date(args.due) or today()
    conn.execute(
        "INSERT INTO tasks (name, priority, category, due_date, reminder, duration) VALUES (?,?,?,?,?,?)",
        (args.name, args.priority.upper(), args.category, date, args.reminder, args.duration)
    )
    conn.commit()
    tid = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    parts = [f"[{args.priority}] {args.name}"]
    if args.reminder:
        parts.append(f"⏰ {args.reminder}")
    if args.duration:
        parts.append(f"⏱ {args.duration}")
    print(f"✅ Добавлено: {' '.join(parts)}  (id={tid})")
    conn.close()

def cmd_done(args):
    conn = get_db()
    now = datetime.datetime.now(MSK).strftime("%H:%M")
    cur = conn.execute(
        "UPDATE tasks SET status='done', done_at=? WHERE id=? AND status='pending'",
        (now, args.id)
    )
    if cur.rowcount:
        t = conn.execute("SELECT name FROM tasks WHERE id=?", (args.id,)).fetchone()
        print(f"✅ {t['name']} — выполнено")
    else:
        print("⚠️ Задача не найдена или уже выполнена")
    conn.commit()
    conn.close()

def cmd_cancel(args):
    conn = get_db()
    cur = conn.execute(
        "UPDATE tasks SET status='cancelled' WHERE id=? AND status='pending'",
        (args.id,)
    )
    if cur.rowcount:
        t = conn.execute("SELECT name FROM tasks WHERE id=?", (args.id,)).fetchone()
        print(f"❌ {t['name']} — отменено")
    else:
        print("⚠️ Задача не найдена или уже закрыта")
    conn.commit()
    conn.close()

def cmd_list(args):
    conn = get_db()
    if args.backlog:
        rows = conn.execute(
            "SELECT * FROM tasks WHERE status='backlog' ORDER BY priority, id"
        ).fetchall()
    elif args.date:
        lookup_date = parse_date(args.date) or args.date
        rows = conn.execute(
            "SELECT * FROM tasks WHERE due_date=? ORDER BY CASE priority WHEN 'H' THEN 0 WHEN 'M' THEN 1 ELSE 2 END, id",
            (lookup_date,)
        ).fetchall()
    elif args.all:
        rows = conn.execute(
            "SELECT * FROM tasks ORDER BY due_date DESC, priority, id"
        ).fetchall()
    else:
        rows = conn.execute(
            "SELECT * FROM tasks WHERE due_date=? AND status!='cancelled' ORDER BY CASE priority WHEN 'H' THEN 0 WHEN 'M' THEN 1 ELSE 2 END, id",
            (today(),)
        ).fetchall()

    if not rows:
        print("📭 Нет задач")
        return

    for r in rows:
        prio_icon = {"H": "🔴", "M": "🟡", "L": "🟢"}.get(r["priority"], "⚪")
        status_icon = {"done": "✅", "pending": "⏳", "cancelled": "❌", "backlog": "📦"}.get(r["status"], "⏳")
        suffix = ""
        if r["reminder"]:
            suffix += f" ⏰{r['reminder']}"
        if r["duration"]:
            suffix += f" ⏱{r['duration']}"
        print(f"  {status_icon} {prio_icon} [{r['id']:2d}] {r['name']}{suffix}")
        if args.all or args.date:
            print(f"         📅 {r['due_date']}  🏷️ {r['category']}")
    conn.close()

def cmd_postpone(args):
    """Перенести задачу на другой день."""
    conn = get_db()
    new_date = parse_date(args.date) or tomorrow_msk()
    cur = conn.execute(
        "UPDATE tasks SET due_date=?, carry_over=COALESCE(carry_over,0)+1 WHERE id=? AND status='pending'",
        (new_date, args.id)
    )
    if cur.rowcount:
        t = conn.execute("SELECT name, carry_over FROM tasks WHERE id=?", (args.id,)).fetchone()
        carries = t["carry_over"]
        print(f"➡️  [{args.id}] {t['name']} → {new_date} (перенос #{carries})")
    else:
        print("⚠️ Задача не найдена или уже закрыта")
    conn.commit()
    conn.close()

def cmd_migrate(args):
    """Перенести просроченные pending-задачи на завтра (по МСК)."""
    conn = get_db()
    rows = conn.execute(
        "SELECT * FROM tasks WHERE due_date<? AND status='pending'",
        (today(),)
    ).fetchall()
    if not rows:
        print("📭 Просроченных задач нет")
        return
    for r in rows:
        carries = (r["carry_over"] or 0) + 1
        conn.execute("UPDATE tasks SET due_date=?, carry_over=? WHERE id=?",
                     (today(), carries, r["id"]))
        print(f"➡️  [{r['id']}] {r['name']} → сегодня (перенос #{carries})")
    conn.commit()
    conn.close()

# ─── Привычки ────────────────────────────────

def cmd_habits(args):
    conn = get_db()
    weekday = datetime.datetime.now(MSK).strftime("%a")  # Mon, Tue, ...
    all_rows = conn.execute("SELECT * FROM habits ORDER BY sort_order, id").fetchall()
    if not all_rows:
        print("📭 Нет привычек")
        return

    # фильтр по дню недели
    rows = []
    hidden = 0
    for r in all_rows:
        days = (r["days"] or "*").strip()
        if days == "*" or weekday[:3] in [d.strip()[:3] for d in days.split(",")]:
            rows.append(r)
        else:
            hidden += 1

    total_done = 0
    for r in rows:
        cnt = conn.execute(
            "SELECT COUNT(*) FROM habit_log WHERE habit_id=? AND date=? AND done=1",
            (r["id"], today())
        ).fetchone()[0]
        icon = f"✅x{cnt}" if cnt > 1 else ("✅" if cnt == 1 else "⏳")
        time_str = f" {r['time']}" if r["time"] else ""
        print(f"  {icon} [{r['id']:2d}] {r['name']}{time_str}")
        if cnt >= 1:
            total_done += cnt
    suffix = f" (+{hidden} не по расписанию)" if hidden else ""
    print(f"\n  Итого: {total_done}/{len(rows)} подходов{suffix}")
    conn.close()

def cmd_habit_done(args):
    conn = get_db()
    now = datetime.datetime.now(MSK).strftime("%H:%M")
    conn.execute(
        "INSERT INTO habit_log (habit_id, date, done, done_at) VALUES (?,?,1,?)",
        (args.id, today(), now)
    )
    h = conn.execute("SELECT name FROM habits WHERE id=?", (args.id,)).fetchone()
    if h:
        cnt = conn.execute(
            "SELECT COUNT(*) FROM habit_log WHERE habit_id=? AND date=? AND done=1",
            (args.id, today())
        ).fetchone()[0]
        label = f"✅ (x{cnt})" if cnt > 1 else "✅"
        print(f"✅ {h['name']} — {label}")
    else:
        print("⚠️ Привычка не найдена")
    conn.commit()
    conn.close()

def cmd_habit_add(args):
    conn = get_db()
    days = args.days or "*"
    max_order = conn.execute("SELECT COALESCE(MAX(sort_order),0)+1 FROM habits").fetchone()[0]
    conn.execute(
        "INSERT INTO habits (name, time, sort_order, days) VALUES (?,?,?,?)",
        (args.name, args.time, max_order, days)
    )
    conn.commit()
    hid = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    days_str = f" [{days}]" if days != "*" else ""
    print(f"✅ Привычка добавлена: {args.name}{days_str}  (id={hid})")
    conn.close()

def cmd_habit_rm(args):
    conn = get_db()
    h = conn.execute("SELECT name FROM habits WHERE id=?", (args.id,)).fetchone()
    if not h:
        print("⚠️ Привычка не найдена")
        return
    conn.execute("DELETE FROM habit_log WHERE habit_id=?", (args.id,))
    conn.execute("DELETE FROM habits WHERE id=?", (args.id,))
    conn.commit()
    print(f"🗑️ Привычка удалена: {h['name']}")
    conn.close()

# ─── Периодические задачи ────────────────────

def cmd_periodic(args):
    conn = get_db()
    rows = conn.execute("SELECT * FROM periodic ORDER BY sort_order, id").fetchall()
    if not rows:
        print("📭 Нет периодических задач")
        return
    for r in rows:
        print(f"  🔄 [{r['id']:2d}] {r['name']} (каждые {r['every']}, {r['start_time']}-{r['end_time']})")
    conn.close()

def cmd_periodic_add(args):
    conn = get_db()
    max_order = conn.execute("SELECT COALESCE(MAX(sort_order),0)+1 FROM periodic").fetchone()[0]
    conn.execute(
        "INSERT INTO periodic (name, every, start_time, end_time, sort_order, last_sent_hour) VALUES (?,?,?,?,?,-1)",
        (args.name, args.every, args.start or "08:00", args.end or "22:00", max_order)
    )
    conn.commit()
    pid = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    print(f"✅ Периодическое добавлено: {args.name} (каждые {args.every}, {args.start or '08:00'}-{args.end or '22:00'})  (id={pid})")
    conn.close()

def cmd_periodic_rm(args):
    conn = get_db()
    p = conn.execute("SELECT name FROM periodic WHERE id=?", (args.id,)).fetchone()
    if not p:
        print("⚠️ Периодическая задача не найдена")
        return
    conn.execute("DELETE FROM periodic WHERE id=?", (args.id,))
    conn.commit()
    print(f"🗑️ Периодическое удалено: {p['name']}")
    conn.close()

# ─── Статус (коротко для Hermes) ──────────

def cmd_status(args):
    conn = get_db()
    # задачи сегодня
    r = conn.execute("""
        SELECT
            SUM(CASE WHEN status='done' THEN 1 ELSE 0 END) as done,
            SUM(CASE WHEN status='pending' THEN 1 ELSE 0 END) as pending,
            SUM(CASE WHEN status='cancelled' THEN 1 ELSE 0 END) as cancelled
        FROM tasks WHERE due_date=? AND status!='backlog'
    """, (today(),)).fetchone()
    d, p, c = r["done"] or 0, r["pending"] or 0, r["cancelled"] or 0
    total = d + p + c

    # привычки сегодня
    habit_total = conn.execute("SELECT COUNT(*) FROM habits").fetchone()[0]
    habit_done = conn.execute(
        "SELECT COUNT(*) FROM habit_log WHERE date=? AND done=1",
        (today(),)
    ).fetchone()[0]

    parts = []
    if total:
        parts.append(f"{total} задач ({d}✅ {p}⏳ {c}❌)")
    else:
        parts.append("нет задач")
    parts.append(f"привычки {habit_done}/{habit_total}")
    print(f"📋 {', '.join(parts)}")
    conn.close()

# ─── Миграция с YAML ──────────────────────────

def cmd_migrate_yaml(args):
    import yaml
    conn = get_db()
    tasks_path = Path.home() / ".hermes" / "tasks" / "tasks.yml"
    habits_path = Path.home() / ".hermes" / "tasks" / "habits.yml"

    if tasks_path.exists():
        with open(tasks_path) as f:
            data = yaml.safe_load(f) or {}
        count = 0
        for section, date_val in [("today", today()), ("tomorrow", tomorrow())]:
            for t in data.get(section, []):
                conn.execute(
                    "INSERT INTO tasks (name, priority, due_date, status) VALUES (?,?,?,'pending')",
                    (t["name"], t.get("priority", "M"), date_val)
                )
                count += 1
        for t in data.get("backlog", []):
            conn.execute(
                "INSERT INTO tasks (name, priority, status) VALUES (?,?,'backlog')",
                (t["name"], t.get("priority", "M"))
            )
            count += 1
        conn.commit()
        print(f"✅ Импортировано задач: {count}")
        # backup
        shutil.copy(tasks_path, tasks_path.with_suffix(".yml.bak"))
        print(f"💾 Бэкап: {tasks_path}.bak")

    if habits_path.exists():
        with open(habits_path) as f:
            data = yaml.safe_load(f) or {}
        count = 0
        for h in data.get("habits", []):
            conn.execute(
                "INSERT OR IGNORE INTO habits (name, time) VALUES (?,?)",
                (h["name"], h.get("time"))
            )
            count += 1
        conn.commit()
        print(f"✅ Импортировано привычек: {count}")
        shutil.copy(habits_path, habits_path.with_suffix(".yml.bak"))
        print(f"💾 Бэкап: {habits_path}.bak")

    conn.close()

# ─── Main ────────────────────────────────────

def main():
    init_db()
    add_days_column()
    parser = argparse.ArgumentParser(prog="t", description="Task tracker")
    sub = parser.add_subparsers(dest="command")

    # tasks
    p = sub.add_parser("add", help="Добавить задачу")
    p.add_argument("name")
    p.add_argument("-p", "--priority", default="M", choices=["H","M","L"])
    p.add_argument("-c", "--category", default="general")
    p.add_argument("-d", "--due", help="Дата (ГГГГ-ММ-ДД), по умолчанию сегодня")
    p.add_argument("-r", "--reminder", help="Время напоминания (ЧЧ:ММ)")
    p.add_argument("--duration", help="Длительность (напр. 1.5ч)")

    sub.add_parser("done", help="Отметить выполненной").add_argument("id", type=int)
    sub.add_parser("cancel", help="Отменить задачу").add_argument("id", type=int)

    p = sub.add_parser("list", help="Список задач")
    p.add_argument("--all", action="store_true")
    p.add_argument("--date")
    p.add_argument("--backlog", action="store_true")

    p = sub.add_parser("postpone", help="Перенести задачу на другой день")
    p.add_argument("id", type=int)
    p.add_argument("-d", "--date", help="Новая дата (ГГГГ-ММ-ДД), по умолчанию завтра")

    sub.add_parser("migrate", help="Перенести просрочку на сегодня")
    sub.add_parser("status", help="Короткий статус для Hermes")
    sub.add_parser("migrate-from-yaml", help="Импорт из YAML")

    # habits
    sub.add_parser("habits", help="Список привычек на сегодня")
    p = sub.add_parser("habit-add", help="Добавить привычку")
    p.add_argument("name")
    p.add_argument("--time")
    p.add_argument("--days", help="Дни недели через запятую (Mon,Tue,Wed...). '*' = ежедневно")
    sub.add_parser("habit-done", help="Отметить привычку").add_argument("id", type=int)
    sub.add_parser("habit-rm", help="Удалить привычку").add_argument("id", type=int)

    # periodic
    sub.add_parser("periodic", help="Список периодических задач")
    p = sub.add_parser("periodic-add", help="Добавить периодическую задачу")
    p.add_argument("name")
    p.add_argument("-e", "--every", required=True, help="Интервал (напр. 1h, 30min)")
    p.add_argument("--start", help="Время начала (ЧЧ:ММ), по умолч. 08:00")
    p.add_argument("--end", help="Время окончания (ЧЧ:ММ), по умолч. 22:00")
    sub.add_parser("periodic-rm", help="Удалить периодическую задачу").add_argument("id", type=int)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return

    cmds = {
        "add": cmd_add, "done": cmd_done, "cancel": cmd_cancel,
        "list": cmd_list, "postpone": cmd_postpone, "migrate": cmd_migrate, "status": cmd_status,
        "migrate-from-yaml": cmd_migrate_yaml,
        "habits": cmd_habits, "habit-add": cmd_habit_add,
        "habit-done": cmd_habit_done, "habit-rm": cmd_habit_rm,
        "periodic": cmd_periodic, "periodic-add": cmd_periodic_add,
        "periodic-rm": cmd_periodic_rm,
    }
    cmds[args.command](args)

if __name__ == "__main__":
    main()
